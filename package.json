{
  "name": "voxen-desktop",
  "productName": "Voxen",
  "version": "0.3.4",
  "description": "Dictée vocale Windows en français avec transcription et reformulation.",
  "main": "src/main/main.cjs",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/install-electron.cjs",
    "build": "webpack --mode production && node scripts/finalize-build.cjs",
    "start": "electron .",
    "package": "npm run build && node scripts/package.cjs",
    "test": "node --test tests/core.cjs tests/audio-routing.cjs tests/writing-features.cjs tests/cloud.cjs tests/updates.cjs",
    "test:ui": "node scripts/test-ui.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build",
    "prepare:runtime": "node scripts/prepare-windows-runtime.cjs",
    "make:installer": "npm run package && node scripts/make-installer.cjs"
  },
  "dependencies": {
    "koffi": "3.3.3",
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/preset-react": "7.27.1",
    "@base-ui/react": "1.6.0",
    "@electron/packager": "20.3.0",
    "@floating-ui/react": "0.27.16",
    "babel-loader": "9.2.1",
    "css-loader": "6.11.0",
    "electron": "42.11.2",
    "electron-winstaller": "5.4.4",
    "lucide-react": "1.46.0",
    "motion": "12.23.25",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "1.93.2",
    "sass-loader": "16.0.5",
    "style-loader": "3.3.4",
    "webpack": "5.112.0",
    "webpack-cli": "6.0.1",
    "zustand": "5.0.9"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/foulezombie94/VOXEN.git"
  }
}
